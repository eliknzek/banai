APP_ENV=local
CORS_ORIGINS=http://localhost:5173
# Never commit real values.
# AI agent (/api/chat). Without all three, /api/chat answers AGENT_UNAVAILABLE.
# APP_ENV=e2e uses a scripted offline agent instead (Playwright).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=        # configurable default, e.g. gpt-5.4
OPENAI_IMAGE_MODEL=
# Voice (spec §9a): push-to-talk STT and spoken replies. Configurable defaults.
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PROPOSAL_SIGNING_KEY=     # HMAC key for agent proposals: python -c "import secrets;print(secrets.token_hex(32))"
